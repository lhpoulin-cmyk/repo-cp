{
  "$id": "urn:helix:repo-cp:work-result:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "clean_execution_baseline",
    "work_entry_id",
    "target_repository",
    "objective",
    "canonical_baseline",
    "workspace_evidence",
    "starting_head",
    "ending_head",
    "starting_dirty_state",
    "ending_dirty_state",
    "ending_dirtiness_attribution",
    "files_changed",
    "mutations_performed",
    "mutations_not_performed",
    "validation",
    "evidence_produced",
    "delivery_stage",
    "status_topology",
    "recommended_next_action",
    "live_effects"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "protocol": { "const": "HELIX_WORK_RESULT_V1" },
    "clean_execution_baseline": { "const": "HELIX_CLEAN_EXECUTION_BASELINE_V1" },
    "work_entry_id": { "$ref": "#/$defs/id" },
    "work_state": { "enum": ["PARKED", "ACTIVE", "PAUSED", "BLOCKED", "COMPLETE"] },
    "priority": { "enum": ["GREEN", "YELLOW", "RED"] },
    "target_repository": { "$ref": "#/$defs/name" },
    "objective": { "$ref": "#/$defs/text" },
    "canonical_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intended_ref", "resolved_head"],
      "properties": {
        "intended_ref": { "$ref": "#/$defs/text" },
        "resolved_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "workspace_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_workspace_identity", "execution_workspace_identity", "isolated_execution", "pre_existing_source_state_preserved"],
      "properties": {
        "source_workspace_identity": { "$ref": "#/$defs/text" },
        "execution_workspace_identity": { "$ref": "#/$defs/text" },
        "isolated_execution": { "type": "boolean" },
        "pre_existing_source_state_preserved": { "type": "boolean" }
      }
    },
    "starting_head": { "$ref": "#/$defs/revision_or_unknown" },
    "ending_head": { "$ref": "#/$defs/revision_or_unknown" },
    "starting_dirty_state": { "$ref": "#/$defs/dirty_state" },
    "ending_dirty_state": { "$ref": "#/$defs/dirty_state" },
    "ending_dirtiness_attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_work_entry", "pre_existing", "unrelated", "unknown"],
      "properties": {
        "current_work_entry": { "$ref": "#/$defs/path_buckets" },
        "pre_existing": { "$ref": "#/$defs/path_buckets" },
        "unrelated": { "$ref": "#/$defs/path_buckets" },
        "unknown": { "$ref": "#/$defs/path_buckets" }
      }
    },
    "files_changed": { "$ref": "#/$defs/unique_texts" },
    "mutations_performed": { "$ref": "#/$defs/unique_texts" },
    "mutations_not_performed": { "$ref": "#/$defs/unique_texts" },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status", "evidence"],
        "properties": {
          "check": { "$ref": "#/$defs/text" },
          "status": { "enum": ["PASS", "UNKNOWN", "DRIFT", "BLOCKED", "NOT_APPLICABLE"] },
          "evidence": { "$ref": "#/$defs/text" }
        }
      }
    },
    "evidence_produced": { "$ref": "#/$defs/unique_texts" },
    "discovery_coverage": { "$ref": "#/$defs/discovery_coverage" },
    "continuation": { "$ref": "#/$defs/continuation" },
    "delivery_stage": { "enum": ["LOCAL_UNCOMMITTED", "COMMITTED", "PUSHED", "MERGED", "PUBLISHED", "DEPLOYED", "LIVE_VERIFIED"] },
    "status_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "relationships"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/status_node" }
        },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship" }
        }
      }
    },
    "recommended_next_action": { "$ref": "#/$defs/text" },
    "live_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "target", "result", "evidence"],
        "properties": {
          "action": { "$ref": "#/$defs/text" },
          "target": { "$ref": "#/$defs/text" },
          "result": { "enum": ["SUCCEEDED", "FAILED", "UNKNOWN"] },
          "evidence": { "$ref": "#/$defs/text" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "unique_texts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "revision_or_unknown": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        { "type": "null" }
      ]
    },
    "dirty_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "staged", "unstaged", "untracked"],
      "properties": {
        "state": { "enum": ["CLEAN", "DIRTY", "UNKNOWN"] },
        "staged": { "$ref": "#/$defs/unique_texts" },
        "unstaged": { "$ref": "#/$defs/unique_texts" },
        "untracked": { "$ref": "#/$defs/unique_texts" }
      }
    },
    "path_buckets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staged", "unstaged", "untracked"],
      "properties": {
        "staged": { "$ref": "#/$defs/unique_texts" },
        "unstaged": { "$ref": "#/$defs/unique_texts" },
        "untracked": { "$ref": "#/$defs/unique_texts" }
      }
    },
    "discovery_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "checks_performed", "remaining_unknowns", "actionable_findings_remaining", "recheck_status", "recheck_evidence"],
      "properties": {
        "scope": { "$ref": "#/$defs/text" },
        "checks_performed": { "$ref": "#/$defs/unique_texts" },
        "remaining_unknowns": { "$ref": "#/$defs/unique_texts" },
        "actionable_findings_remaining": { "$ref": "#/$defs/unique_texts" },
        "recheck_status": { "enum": ["NOT_REQUIRED", "PENDING", "COMPLETED"] },
        "recheck_evidence": { "$ref": "#/$defs/unique_texts" }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id",
        "work_entry_id",
        "workspace_state_preserved",
        "mutation_gate_at_handoff",
        "in_flight_invocation",
        "session_binding",
        "session_disposition",
        "continuation_point",
        "revalidation_requirements",
        "revalidation_status"
      ],
      "properties": {
        "handoff_id": { "$ref": "#/$defs/id" },
        "work_entry_id": { "$ref": "#/$defs/id" },
        "workspace_state_preserved": { "const": true },
        "mutation_gate_at_handoff": { "enum": ["OPEN", "CLOSED"] },
        "in_flight_invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "disposition", "attribution"],
          "properties": {
            "identity": { "$ref": "#/$defs/text" },
            "disposition": { "enum": ["NONE", "COMPLETED", "INTERRUPTED", "CANCELLED", "UNKNOWN"] },
            "attribution": { "enum": ["NONE", "CURRENT_WORK_ENTRY", "PRE_EXISTING", "UNRELATED", "UNKNOWN"] }
          }
        },
        "session_binding": { "$ref": "#/$defs/text" },
        "session_disposition": { "enum": ["BOUND", "RELEASED", "UNKNOWN"] },
        "continuation_point": { "$ref": "#/$defs/text" },
        "revalidation_requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "revalidation_status": { "enum": ["PENDING", "COMPLETED"] }
      }
    },
    "status_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "summary", "owner", "blocking"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["WORK", "FINDING", "FUTURE_WORK", "DEPENDENCY", "EXTERNAL_DEPENDENCY", "CROSS_CONTROL_PLANE_REQUEST", "AUTHORIZATION"] },
        "status": { "enum": ["COMPLETED", "ACTIVE", "PAUSED", "PARKED", "PENDING", "BLOCKED", "NON_BLOCKING_INCOMPLETE", "UNKNOWN", "DRIFT", "AUTHORIZATION_REQUIRED"] },
        "priority": { "enum": ["GREEN", "YELLOW", "RED"] },
        "summary": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "blocking": { "type": "boolean" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "object"],
      "properties": {
        "subject": { "$ref": "#/$defs/id" },
        "predicate": { "enum": ["BLOCKED_BY", "DEPENDS_ON", "NON_BLOCKING_FOR", "REQUIRES_AUTHORIZATION_FROM", "MAY_BE_RESOLVED_BY", "OWNED_BY", "HANDOFF_TO", "SUPERSEDES", "PROMOTED_TO"] },
        "object": { "$ref": "#/$defs/id" }
      }
    }
  }
}
